{
  "name": "terra-woi",
  "version": "0.1.0",
  "description": "Pemantau potensi gempa bumi, hujan/longsor, dan gunung api di sekitar lokasi pengguna (Indonesia)",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js --dev",
    "android:sync": "cap sync android",
    "android:buka": "cap open android",
    "android:apk": "cap sync android && cd android && gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
